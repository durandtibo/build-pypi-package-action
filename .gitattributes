# Ship only what the action needs at runtime (action.yml, LICENSE). Everything else is excluded
# from `git archive`, i.e. from what the consumers of a release get. When the action starts
# using a new file, un-ignore it here and add it to EXPECTED in dev/check_export.sh.
/.github/ export-ignore
/.idea/ export-ignore
/.make/ export-ignore
/dev/ export-ignore
/review/ export-ignore
/scripts/ export-ignore
/test/ export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.yamllint.yaml export-ignore
/CLAUDE.md export-ignore
/CODEOWNERS export-ignore
/CODE_OF_CONDUCT.md export-ignore
/Makefile export-ignore
/README.md export-ignore
/SECURITY.md export-ignore
